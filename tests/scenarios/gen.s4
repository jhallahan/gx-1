# GX-1: the GEN page. It opens there; FX a new idea; tracks picked and muted on the black keys; a macro turned;
# GLO + white keys: mutate and the parts; ENV lock; EDIT undo; HOME to the grid and back
wait 400
expect view 5
shot gen_boot.png
tap FX
wait 300
expect mode 1
tap PLAY
wait 2200
expect playing 1
expect notes_on >20
shot gen_playing.png
tapkey b1
wait 100
expect sel 1
expect mode 0
turn K1 6
wait 600
shot gen_density.png
tapkey b2
expect sel 2
press GLO
wait 100
shot gen_glo.png
tapkey w0
tapkey w12
release GLO
wait 400
expect view 5
shot gen_mutate.png
tap ENV
wait 200
tapkey b5
wait 200
expect mute 0
shot gen_locked_muted.png
tapkey b5
tap EDIT
wait 200
tap HOME
wait 300
expect view 0
tap HOME
wait 300
expect view 5
tap PLAY
wait 300
expect playing 0
