# GX-1: the GEN page. It opens there; FX a new idea; tracks picked and muted on the black keys; a macro turned;
# GLO + white keys: mutate and the parts; ENV lock; EDIT undo; HOME to the grid and back
wait 400
expect view 5
shot gen_boot.png
tap FX
wait 300
expect mode 1
expect tempo 1300
# SELECT: the tempo; it stays through new ideas, mutations and macros (only a new genre sets it: ADR-028)
spin SELECT 12
expect tempo 1420
wait 1600
shot gen_tempo_out.png
spin SELECT -12
tap FX
wait 300
expect tempo 1300
spin SELECT 4
tap FX
wait 300
expect tempo 1340
# OCT+ / OCT-: the key; GLO + FX: re-roll the selected track
tap OCT+
tap OCT+
wait 300
shot gen_key.png
tap OCT-
press GLO
tap FX
release GLO
wait 300
tap PLAY
wait 2200
expect playing 1
expect notes_on >20
shot gen_playing.png
# a new idea while playing comes in at the next bar line (from its bar 1), not at the end of the 8-bar loop
tap FX
until next -1 2200
tapkey b1
wait 100
expect sel 1
expect mode 0
turn K1 6
wait 600
shot gen_density.png
tapkey b2
expect sel 2
wait 1600
shot gen_chords.png
press GLO
wait 100
shot gen_glo.png
tapkey w0
tapkey w12
release GLO
wait 400
expect view 5
shot gen_mutate.png
tap ENV
wait 200
tapkey b5
wait 200
expect mute 0
shot gen_locked_muted.png
tapkey b5
tap EDIT
wait 200
tap HOME
wait 300
expect view 0
tap HOME
wait 300
expect view 5
# ALGORITHM: the genre (a new idea in it when the knob rests): Breaks -> Autonomic -> Dub techno
turn ALGO 2
wait 1000
until next -1 2400
wait 1600
shot gen_dub.png
expect tempo 1220
tap PLAY
wait 300
expect playing 0
