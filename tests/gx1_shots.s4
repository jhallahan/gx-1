# GX-1's screenshots for the README, the manual and the site (tools/manual_shots.sh): GEN, TRACK (drums, chords),
# ARRANGE; GEN with Chords picked, GLO held, a part queued; the grid underneath
wait 300
gx map tonverk
gx new liquid 2 1
tap PLAY
wait 2200
shot gx1-gen.png
tap HOME
wait 700
shot gx1-track.png
key b2 down
key b2 up
wait 400
shot gx1-track-chords.png
tap HOME
wait 700
shot gx1-arrange-now.png
tap HOME
wait 700
shot gx1-chords.png
press GLO
wait 300
shot gx1-glo.png
key w11 down
key w11 up
wait 200
shot gx1-part-next.png
release GLO
wait 300
key b0 down
key b0 up
tap HOME
wait 700
tap HOME
wait 700
key w4 down
key w4 up
wait 400
shot gx1-arrange.png
tap HOME
wait 700
tap SEQ
wait 400
shot gx1-grid.png
tap HOME
wait 400
tap PLAY
wait 200
